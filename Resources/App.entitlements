<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Under the hardened runtime an app may only send Apple events with this. Dotmeter sends one kind: asking the
	     Finder to move an item to the Trash when the item needs the Finder's authority to move. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
